###############################
# Backend environment variables
# Renomeie este arquivo para ".env" e ajuste os valores
###############################

# Server
PORT=3000
NODE_ENV=development

# Database (MySQL)
# Use os mesmos nomes da app: DB_DATABASE
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_DATABASE=tcc

# CPFs autorizados a consultar /api/auditoria (apenas dígitos, separados por vírgula)
# Exemplo: 12345678901,98765432100
ADMIN_CPFS=12345678901,98765432100
